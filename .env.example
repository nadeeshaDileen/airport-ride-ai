# Copy to .env (never commit .env) and fill in your own values.
# The scripts read these from the environment. One way to load them:
#   set -a; source .env; set +a

# Your named AWS CLI profile (do not use "default").
AWS_PROFILE=<your-aws-profile>

# Created by scripts/setup-aws.sh (needed for steps 04-07).
KNOWLEDGE_BASE_ID=<your-kb-id>
GUARDRAIL_ID=<your-guardrail-id>
GUARDRAIL_VERSION=1

# Used only by scripts/setup-aws.sh and scripts/cleanup-aws.sh.
NAME_PREFIX=palmway-ai
AWS_REGION=us-east-1
